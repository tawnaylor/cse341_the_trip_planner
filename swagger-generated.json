{
  "swagger": "2.0",
  "info": {
    "title": "Group Trip Planner API",
    "version": "1.0.0",
    "description": "Activities CRUD and voting for group trips. Protected routes require a signed-in session. Authentication integration is still pending; Activities return 401 until a valid session is available"
  },
  "basePath": "/",
  "tags": [
    {
      "name": "Activities",
      "description": "Create, view, update, delete, and vote on trip activities"
    },
    {
      "name": "Expenses",
      "description": "Log shared expenses and see who owes whom. All amounts are integer cents"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/trips/{tripId}/activities": {
      "get": {
        "tags": [
          "Activities"
        ],
        "summary": "List activities for a trip, most votes first",
        "description": "Equal vote counts use activity ID order for a stable display. This does not select an itinerary winner",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        ],
        "responses": {
          "200": {
            "description": "Activities returned",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Activity"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid request, activity date outside the trip dates, or trip not open for planning.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Sign in is required.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "Not a trip member, or not permitted to change this activity",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Trip or activity not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "An unexpected server or database error occurred",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "tags": [
          "Activities"
        ],
        "summary": "Suggest an activity for a trip",
        "description": "",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ActivityInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Activity created.",
            "schema": {
              "$ref": "#/definitions/Activity"
            }
          },
          "400": {
            "description": "Invalid request, activity date outside the trip dates, or trip not open for planning.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Sign in is required.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
