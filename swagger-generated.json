  "definitions": {
    "ExpenseInput": {
      "type": "object",
      "required": [
        "description",
        "amountCents",
        "paidBy",
        "splitType",
        "category",
        "date"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "example": "Cabin rental"
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1,
          "example": 45000
        },
        "paidBy": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$",
          "description": "Trip member who paid"
        },
        "splitType": {
          "type": "string",
          "enum": [
            "equal",
            "percentage",
            "custom"
          ]
        },
        "splits": {
          "type": "array",
          "description": "Required for percentage (userId and percent, totaling 100) and custom (userId and amountCents, totaling amountCents) splits. Ignored for equal",
          "items": {
            "type": "object",
            "required": [
              "userId"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              },
              "percent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "amountCents": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "lodging",
            "food",
            "transport",
            "activity",
            "other"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "example": {
        "description": "Cabin rental",
        "amountCents": 45000,
        "paidBy": "67a123456789abcdef000002",
        "splitType": "equal",
        "category": "lodging",
        "date": "2026-07-01"
      }
    },
    "Expense": {
      "type": "object",
      "required": [
        "_id",
        "tripId",
        "description",
        "amountCents",
        "paidBy",
        "splitType",
        "splits",
        "category",
        "date"
      ],
      "properties": {
        "_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "tripId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "description": {
          "type": "string"
        },
        "amountCents": {
          "type": "integer"
        },
        "paidBy": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "splitType": {
          "type": "string",
          "enum": [
            "equal",
            "percentage",
            "custom"
          ]
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "category": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Settlement": {
      "type": "object",
      "required": [
        "balances",
        "payments"
      ],
      "properties": {
        "balances": {
          "type": "object",
          "description": "Net cents per user ID. Positive is owed money, negative owes money",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "payments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              },
              "amountCents": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "example": {
        "balances": {
          "67a123456789abcdef000002": 1500,
          "67a123456789abcdef000003": -1500
        },
        "payments": [
          {
            "from": "67a123456789abcdef000003",
            "to": "67a123456789abcdef000002",
            "amountCents": 1500
          }
        ]
      }
    },
    "ActivityInput": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "\\S",
          "description": "Required. Trimmed; must contain 3-100 characters and non-whitespace text"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional activity details; trimmed, at most 500 characters"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Optional YYYY-MM-DD date within the trip dates, using UTC calendar days"
        },
        "estimatedCost": {
          "type": "number",
          "minimum": 0,
          "description": "Optional estimated cost in the agreed trip currency"
        }
      },
      "example": {
        "title": "Visit the night market",
        "description": "Explore the food stalls together",
        "estimatedCost": 15
      }
    },
    "Activity": {
      "type": "object",
      "required": [
        "_id",
        "tripId",
        "proposedBy",
        "title",
        "votes",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "\\S",
          "description": "Required. Trimmed; must contain 3-100 characters and non-whitespace text"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional activity details; trimmed, at most 500 characters"
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "Optional YYYY-MM-DD date within the trip dates, using UTC calendar days"
        },
        "estimatedCost": {
          "type": "number",
          "minimum": 0,
          "description": "Optional estimated cost in the agreed trip currency"
        },
        "_id": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "tripId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "proposedBy": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "votes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "selected",
            "rejected"
          ]
        }
      }
    },
    "VoteResult": {
      "type": "object",
      "required": [
        "message",
        "activityId",
        "voted",
        "voteCount"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "activityId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{24}$"
        },
        "voted": {
          "type": "boolean",
          "description": "Whether you have a vote after this request"
        },
        "voteCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "example": {
        "message": "Vote added",
        "activityId": "67a123456789abcdef000003",
        "voted": true,
        "voteCount": 1
      }
    },
    "Message": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
