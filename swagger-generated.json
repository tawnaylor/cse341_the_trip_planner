    "/trips/{tripId}/activities/{activityId}/vote": {
      "put": {
        "tags": [
          "Activities"
        ],
        "summary": "Toggle your vote for an activity",
        "description": "Any signed-in trip member or organizer can vote while the trip is planning. No request body. First call adds your vote; next call removes it. Each user has at most one vote per activity and may vote on multiple activities. Every call toggles, including retries; check the activity before retrying an uncertain request. Winner selection happens separately when the itinerary is locked",
        "parameters": [
          {
            "name": "tripId",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          }
        ],
        "responses": {
          "200": {
            "description": "Vote added or removed.",
            "schema": {
              "$ref": "#/definitions/VoteResult"
            }
          },
          "400": {
            "description": "Invalid request, activity date outside the trip dates, or trip not open for planning.",
            "schema": {
